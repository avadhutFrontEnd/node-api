{
  "info": {
    "name": "Genre API — Validation Tests (8.1–8.4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "8.1 Built-in validators",
      "item": [
        {
          "name": "Invalid — empty name (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"code\": \"action\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Invalid — name too short (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"code\": \"action\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Valid — with defaults (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science Fiction\",\n  \"code\": \"scifi\",\n  \"tags\": [\"sci-fi\", \"space\"]\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        }
      ]
    },
    {
      "name": "8.2 Custom validators",
      "item": [
        {
          "name": "Invalid — code A1 (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Action\",\n  \"code\": \"A1\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Invalid — code too short (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Short\",\n  \"code\": \"a\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Invalid — reserved name 'invalid' (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"invalid\",\n  \"code\": \"reserved\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Invalid — reserved name 'INVALID' (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"INVALID\",\n  \"code\": \"reserved\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        }
      ]
    },
    {
      "name": "8.3 Async slug uniqueness",
      "item": [
        {
          "name": "First — slug action (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Action\",\n  \"code\": \"action\",\n  \"slug\": \"action\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Duplicate — same slug (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Action Two\",\n  \"code\": \"action2\",\n  \"slug\": \"action\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Unique slug (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Drama\",\n  \"code\": \"drama\",\n  \"slug\": \"drama\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "No slug — optional (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Thriller\",\n  \"code\": \"thriller\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        }
      ]
    },
    {
      "name": "8.4 Validation errors object",
      "item": [
        {
          "name": "Multiple errors — 400 + errors array",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"code\": \"A1\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Valid — 201 + document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comedy\",\n  \"code\": \"comedy\",\n  \"slug\": \"comedy\",\n  \"tags\": [\"funny\"]\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        }
      ]
    }
  ]
}
